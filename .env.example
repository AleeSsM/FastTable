EXPO_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key

# Obligatorio solo para web desplegada (sin barra final). Debe coincidir con
# Site URL en Supabase y con el dominio donde publiques host/.
# Ejemplo: https://mi-restaurante.vercel.app
EXPO_PUBLIC_APP_URL=

# Solo para la consola local de personal (`npm run staff:console`).
# No la subas a Git ni la configures como EXPO_PUBLIC_: otorga acceso total.
# SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key
